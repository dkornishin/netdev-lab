pycache/
.pytest_cache/
.coverage
htmlcov/

--- Секреты и локальные конфиги ---
.env
secrets.json
config.local.yml
config.yaml
*.key
*.pem
*.pfx

--- Артефакты и логи ---
logs/
log/
*.log
tmp/
temp/
build/
dist/
*.egg-info

--- YAML/Ansible: кэш и артефакты ---
.ansible/
*.retry

--- Docker (если будешь использовать в проекте) ---
docker-compose.override.yml
.env.docker